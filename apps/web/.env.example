# TechSeeker Next.js Frontend Configuration (.env.local)

# Public URL of the FastAPI Backend (e.g. https://techseeker-api.onrender.com)
NEXT_PUBLIC_API_URL=https://techseeker-api.onrender.com

# Google OAuth 2.0 Client ID for Frontend Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
