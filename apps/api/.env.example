# TechSeeker Backend API Configuration (.env)
APP_NAME=TechSeeker API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Neon / PostgreSQL
# DATABASE_URL = Neon pooled connection URI (PgBouncer mode)
DATABASE_URL=postgresql+psycopg://username:password@ep-sample-pooler.region.aws.neon.tech/techseeker?sslmode=require
# DIRECT_URL = Neon direct unpooled connection URI (for Alembic migrations)
DIRECT_URL=postgresql+psycopg://username:password@ep-sample.region.aws.neon.tech/techseeker?sslmode=require

# Upstash / Redis
REDIS_URL=rediss://default:your_upstash_redis_token@your-redis-host.upstash.io:6379

# Code Runner Service (Render Private Service URL or internal localhost)
RUNNER_SERVICE_URL=http://techseeker-runner:8001/execute

# Security & CORS
SECRET_KEY=generate_a_secure_random_64_character_hex_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=https://techseeker.vercel.app,http://localhost:3000

# Google Gemini API Keys (comma-separated)
GEMINI_API_KEYS=AIzaSy...key1,AIzaSy...key2

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
