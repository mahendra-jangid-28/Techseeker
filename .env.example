# ==============================================================================
# TechSeeker Unified Environment Configuration
# Copy this file to .env (root/Docker), apps/api/.env (backend), apps/web/.env.local (frontend)
# ==============================================================================

# Application Environment ('development' | 'production')
APP_NAME=TechSeeker API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# ==============================================================================
# Database Configuration (Neon / PostgreSQL)
# ==============================================================================
# DATABASE_URL: PgBouncer pooled connection URI used for FastAPI runtime
DATABASE_URL=postgresql+psycopg://techseeker:postgres@localhost:5432/techseeker

# DIRECT_URL: Direct unpooled connection URI required for Alembic migrations in Neon
DIRECT_URL=postgresql+psycopg://techseeker:postgres@localhost:5432/techseeker

# Local Docker Compose defaults
POSTGRES_DB=techseeker
POSTGRES_USER=techseeker
POSTGRES_PASSWORD=techseeker

# ==============================================================================
# Cache Configuration (Upstash / Redis)
# ==============================================================================
# REDIS_URL: Connection URI for Redis / Upstash (e.g. rediss://default:token@host:6379)
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Code Runner Service (apps/runner)
# ==============================================================================
RUNNER_SERVICE_URL=http://localhost:8001/execute

# ==============================================================================
# Frontend & API Network URLs
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://techseeker.vercel.app

# ==============================================================================
# Authentication & Security
# ==============================================================================
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# AI Provider (Google Gemini)
# ==============================================================================
# Comma-separated Gemini API keys for round-robin rotation and fallback
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# ==============================================================================
# Google OAuth 2.0 Credentials
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com