# ==========================================
# TechSeeker Environment Configuration
# Copy this file to .env or apps/api/.env and apps/web/.env.local
# ==========================================

# Application Settings
APP_NAME=TechSeeker API
APP_VERSION=0.1.0
DEBUG=true

# Database & Cache
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/techseeker
POSTGRES_DB=techseeker
POSTGRES_USER=techseeker
POSTGRES_PASSWORD=techseeker
REDIS_URL=redis://redis:6379/0

# API & Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & Security
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider (Gemini API keys, comma-separated for rotation)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com